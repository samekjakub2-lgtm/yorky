# Skopíruj do .env.local (je v .gitignore). Tu sú IBA názvy premenných, nikdy hodnoty.
# Produkčné hodnoty patria do nastavení prostredia na Verceli / Supabase secrets.

# --- Verejné (dostanú sa do prehliadača) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# --- Tajné (iba server, moduly s `import 'server-only'`) ---
SUPABASE_SECRET_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# ID cien (price_…) predplatného v Stripe – nie sú tajné, ale používa ich iba server.
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_YEARLY=
# Verejná adresa aplikácie (návrat z Stripe Checkoutu / Customer Portalu).
APP_URL=
VAPID_PRIVATE_KEY=
